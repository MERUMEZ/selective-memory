# --- Секреты ---
.env

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# --- Базы данных (per-user "мозги", генерируются на сервере) ---
# Это ЧУЖИЕ переписки: узлы хранят текст сообщений, а имя файла — telegram
# id человека. В публичный репозиторий им нельзя.
#
# Шаблон нарочно кончается на *, а не на .db: прежний storage/brains/*.db
# не ловил файлы вида ".db.backup", где расширение не последнее, и одна
# живая база пролежала отслеживаемой до ревизии перед публикацией.
storage/*.db*
storage/brains/*
storage/test_brains/*
!storage/brains/.gitkeep
!storage/test_brains/.gitkeep
*.db-journal
*.db-wal
*.db-shm

# --- Логи ---
# Каталог целиком: ротация создаёт brain.log.1, brain.log.2 — они НЕ
# подходят под шаблон *.log и однажды уже просочились в git status.
storage/logs/
*.log
*.log.*

# --- Модели (кэш, скачивается на сервере) ---
storage/models/*
!storage/models/.gitkeep

# --- Артефакты сборки пакета ---
build/
dist/
*.whl

# --- Сгенерированное ---
# Дамп кодовой базы пересобирается generate_full_dump.py за секунду.
# Хранить в git копию всего репозитория внутри репозитория незачем: она
# устаревает с первым же коммитом и раздувает каждый диф на 9 тысяч строк.
FULL_DUMP.md

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
# --- Данные бенчмарков (качаются отдельно, сотни МБ) ---
storage/bench/

# --- Локальные настройки Claude Code ---
# Журнал выданных разрешений: чужому человеку бесполезен, а рассказывает
# лишнее о машине — какие ещё сервисы на ней крутятся и как называются
# ключи в .env.
.claude/

# Инструкции для агента — к продукту отношения не имеют
CLAUDE.md

# --- Витрина: уехала в свой репозиторий ---
# github.com/MERUMEZ/mindnumbness — телеграм-бот, характер, речевые стадии,
# мини-приложение. Она ПОТРЕБИТЕЛЬ этого пакета, а не его часть: ставит
# selective-memory через pip и живёт своей жизнью.
#
# Файлы перечислены здесь, а не удалены с диска, по одной причине: на этой
# машине витрина работает прямо отсюда, и снос каталогов уронил бы живого
# бота. Для репозитория библиотеки их нет; на сервере они лежат, пока
# развёртывание не переведут на новый репозиторий.
core/
services/
deploy/
storage/utils/
bot.py
config.py
DEMO.md
requirements.txt
tools/miniapp.py
tools/render_memory.py
tools/simulate_learning.py
tests/test_arousal.py
tests/test_attachment.py
tests/test_babbling.py
tests/test_brain_clock.py
tests/test_correction_session.py
tests/test_dashboard.py
tests/test_demo_commands.py
tests/test_exploration.py
tests/test_mood_appraisal.py
tests/test_one_word_stage.py
tests/test_reward_prediction.py
tests/test_session_concurrency.py
tests/test_settings.py
tests/test_miniapp_auth.py
